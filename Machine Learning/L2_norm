":"code","source":["rr=Ridge_Regression(alpha=0.4)\n","rr.fit(X_train,y_train)\n","r2_score(y_test,rr.predict(X_test))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"WeqBtGJdaTrJ","executionInfo":{"status":"ok","timestamp":1783962427350,"user_tz":-330,"elapsed":11,"user":{"displayName":"Adnan Iqbal","userId":"12864988716058579020"}},"outputId":"567a0a58-7760-4b53-92ca-ca1549fd2fef"},"execution_count":42,"outputs":[{"output_type":"execute_result","data":{"text/plain":["0.6351545733365"]},"metadata":{},"execution_count":42}]},{"cell_type":"markdown","source":["**L2 Norm with N dimensional data**"],"metadata":{"id":"qX-hxdr4rzm_"}},{"cell_type":"code","source":["X,y=load_diabetes(return_X_y=True)\n","X_train,X_test,y_train,y_test=train_test_split(X,y,test_size=0.2,random_state=2)"],"metadata":{"id":"hcLeIvopryrD","executionInfo":{"status":"ok","timestamp":1783970108899,"user_tz":-330,"elapsed":29,"user":{"displayName":"Adnan Iqbal","userId":"12864988716058579020"}}},"execution_count":93,"outputs":[]},{"cell_type":"code","source":["class Ridge_Regression_NDimensional():\n","  def __init__(self,alpha):\n","    self.alpha=alpha\n","    self.w=None\n","    self.b=None\n","  def fit(self,X_train,y_train):\n","    X_train=np.insert(X_train,0,1,axis=1)\n","    I=np.identity(X_train.shape[1])\n","    I[0][0]=0           #### Don't want the Identity matrix logic to be applied on the w0 constraint###\n","    res=np.dot(np.linalg.inv(np.dot(X_train.T,X_train)+self.alpha*I),np.dot(X_train.T,y_train))\n","    self.w=res[1:]\n","    self.b=res[0]\n","    return self.w,self.b\n","  def predict(self,X_test):\n","    return np.dot(X_test,self.w) + self.b"],"metadata":{"id":"uPpdrTczsGws","executionInfo":{"status":"ok","timestamp":1783967423129,"user_tz":-330,"elapsed":2,"user":{"displayName":"Adnan Iqbal","userId":"12864988716058579020"}}},"execution_count":51,"outputs":[]},{"cell_type":"code","source":["rrnd=Ridge_Regression_NDimensional(alpha=0.5)\n","rrnd.fit(X_t