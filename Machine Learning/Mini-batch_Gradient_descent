"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"RkrRvg8_D_wM","executionInfo":{"status":"ok","timestamp":1783779785533,"user_tz":-330,"elapsed":42,"user":{"displayName":"Adnan Iqbal","userId":"12864988716058579020"}},"outputId":"b3606985-7f7e-4a63-d168-d9330a583595"},"execution_count":null,"outputs":[{"output_type":"execute_result","data":{"text/plain":["0.42471686216232396"]},"metadata":{},"execution_count":51}]},{"cell_type":"code","source":["from sklearn.linear_model import SGDRegressor\n","SGD=SGDRegressor(learning_rate='constant',eta0=0.5,max_iter=50,batch_size=35)\n","SGD.fit(X_train,y_train)\n","r2_score(y_test,SGD.predict(X_test))"],"metadata":{"id":"fO6mXtD6ZrYk"},"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"b02a0d31"},"source":["from sklearn.linear_model import SGDRegressor\n","sgd_default = SGDRegressor()\n","\n","print(\"Default parameters for SGDRegressor:\")\n","print(f\"  loss: {sgd_default.loss}\")\n","print(f\"  penalty: {sgd_default.penalty}\")\n","print(f\"  alpha: {sgd_default.alpha}\")\n","print(f\"  l1_ratio: {sgd_default.l1_ratio}\")\n","print(f\"  fit_intercept: {sgd_default.fit_intercept}\")\n","print(f\"  max_iter: {sgd_default.max_iter}\")\n","print(f\"  tol: {sgd_default.tol}\")\n","print(f\"  shuffle: {sgd_default.shuffle}\")\n","print(f\"  eta0: {sgd_default.eta0}\")\n","print(f\"  learning_rate: {sgd_default.learning_rate}\")\n","print(f\"  power_t: {sgd_default.power_t}\")\n","# Note: batch_size is not a direct parameter in the constructor when learning_rate is 'invscaling' (default).\n","# It is often implicitly determined or taken from the 'n_samples' in each iteration during training."],"execution_count":null,"outputs":[]}]}